# Copy to backend/.env and set a strong random token and encryption key.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SAM_LOCAL_API_TOKEN=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SAM_MEMORY_FERNET_KEY=
SAM_DATA_DIR=./data
SAM_WORKSPACE_DIR=./workspace
SAM_ALLOWED_ORIGINS=http://127.0.0.1:4317,http://localhost:4317
SAM_DEFAULT_PROVIDER=ollama
SAM_DEFAULT_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
TAVILY_API_KEY=
# Optional Piper executable/model; leave blank to disable local TTS.
PIPER_BIN=
PIPER_MODEL=
# Optional faster-whisper model: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
